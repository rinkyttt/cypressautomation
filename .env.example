# Flight Data Scraper Configuration
# Copy this file to .env and add your actual credentials

# OpenSky Network credentials (optional, but recommended for higher rate limits)
# Register at: https://opensky-network.org/
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# Flightradar24 API key (requires subscription)
# Get API access at: https://www.flightradar24.com/commercial-services/api
FR24_API_KEY=your_fr24_api_key_here

# Rate limiting settings
REQUEST_DELAY=1  # Delay between requests in seconds
MAX_RETRIES=3    # Maximum number of retry attempts